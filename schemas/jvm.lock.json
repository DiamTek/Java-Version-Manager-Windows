{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DiamTek JVM Lockfile Schema",
    "description": "Schema definition for DiamTek JVM reproducible lockfiles (.jvm.lock).",
    "type": "object",
    "required": [
        "schema",
        "lockfile_version",
        "platform",
        "generated_at",
        "tools"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URL to the JSON schema."
        },
        "schema": {
            "type": "integer",
            "enum": [
                2
            ],
            "description": "Schema format version."
        },
        "lockfile_version": {
            "type": "integer",
            "enum": [
                1
            ],
            "description": "Internal lockfile revision number."
        },
        "version": {
            "type": "integer",
            "enum": [
                1
            ],
            "description": "Legacy lockfile revision alias."
        },
        "platform": {
            "type": "string",
            "enum": [
                "windows-x64",
                "windows-arm64"
            ],
            "description": "Target Windows operating system platform."
        },
        "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 UTC timestamp when this lockfile was generated."
        },
        "generated": {
            "type": "string",
            "description": "Legacy UTC timestamp field."
        },
        "tools": {
            "type": "object",
            "description": "Dictionary of locked runtimes and build tools.",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "version",
                    "arch",
                    "url",
                    "checksum_type",
                    "checksum"
                ],
                "properties": {
                    "version": {
                        "type": "string",
                        "pattern": "^[0-9A-Za-z._+-]{1,64}$",
                        "description": "Full semantic version or major release number."
                    },
                    "vendor": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^[0-9A-Za-z._+-]{1,64}$",
                        "description": "Distribution vendor name (e.g. adoptium, oracle, corretto)."
                    },
                    "arch": {
                        "type": "string",
                        "enum": [
                            "x64",
                            "aarch64",
                            "windows-x64",
                            "windows-arm64",
                            "all",
                            "any"
                        ],
                        "description": "Binary architecture target."
                    },
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://",
                        "description": "Secure HTTPS download URL."
                    },
                    "checksum_type": {
                        "type": "string",
                        "default": "sha256",
                        "enum": [
                            "sha256",
                            "sha512",
                            "sha1",
                            "md5"
                        ],
                        "description": "Cryptographic digest algorithm. SHA-256 or SHA-512 is required by default; sha1 and md5 require an explicit --allow-weak-checksum compatibility exception (CWE-328)."
                    },
                    "checksum": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{32,128}$",
                        "description": "Hexadecimal cryptographic digest string."
                    },
                    "provenance": {
                        "type": "string",
                        "enum": [
                            "upstream-verified",
                            "user-supplied"
                        ],
                        "description": "Provenance classification of the locked artifact metadata."
                    },
                    "publisher_authenticated": {
                        "type": "boolean",
                        "description": "Whether the URL and checksum were verified directly against official upstream publisher metadata."
                    },
                    "source_type": {
                        "type": "string",
                        "enum": [
                            "official",
                            "custom"
                        ],
                        "description": "Optional repository source classification."
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "checksum_type": {
                                    "const": "sha256"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "checksum": {
                                    "pattern": "^[0-9a-fA-F]{64}$"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "checksum_type": {
                                    "const": "sha512"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "checksum": {
                                    "pattern": "^[0-9a-fA-F]{128}$"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "checksum_type": {
                                    "const": "sha1"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "checksum": {
                                    "pattern": "^[0-9a-fA-F]{40}$"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "checksum_type": {
                                    "const": "md5"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "checksum": {
                                    "pattern": "^[0-9a-fA-F]{32}$"
                                }
                            }
                        }
                    }
                ]
            }
        }
    }
}