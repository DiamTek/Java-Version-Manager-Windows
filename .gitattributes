# Ensure Windows script files always use CRLF line endings.
# CMD.EXE requires CRLF; LF-only files cause 'echo' to split into 'e' + 'cho'.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf linguist-vendored

# Documentation & web assets ignored by GitHub Linguist statistics
*.html  text eol=lf linguist-vendored linguist-documentation

# Everything else: normalize to LF in the repo, checkout as-is on Linux/Mac
*       text=auto